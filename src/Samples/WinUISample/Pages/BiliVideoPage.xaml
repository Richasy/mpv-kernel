<?xml version="1.0" encoding="utf-8" ?>
<local:BiliVideoPageBase
    x:Class="WinUISample.Pages.BiliVideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUISample.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid
            Margin="20"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="请扫码登录" />
            <Image
                x:Name="QRCodeImage"
                Grid.Row="1"
                MaxWidth="200"
                HorizontalAlignment="Stretch"
                Stretch="Uniform" />
        </Grid>
        <Grid
            Margin="12"
            RowSpacing="12"
            Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <PersonPicture
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}"
                    ProfilePicture="{x:Bind ViewModel.UserAvatar, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Top"
                Spacing="8">
                <TextBox
                    x:Name="LinkBox"
                    Width="280"
                    VerticalAlignment="Center"
                    Header="视频链接"
                    PlaceholderText="输入视频的网址"
                    Text="{x:Bind ViewModel.VideoLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    MinWidth="120"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.PlayCommand}"
                    Content="播放"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</local:BiliVideoPageBase>
