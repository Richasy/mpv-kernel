<?xml version="1.0" encoding="utf-8" ?>
<local:WebDavVideoPageBase
    x:Class="WinUISample.Pages.WebDavVideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:WinUISample.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUISample.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="using:WinUISample.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <base:EmptyHolder
            Title="添加配置"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Description="需要添加一个 WebDAV 配置"
            Emoji="&#x1F5C2;"
            Visibility="{x:Bind ViewModel.IsNoConfig, Mode=OneWay}">
            <base:EmptyHolder.ActionElement>
                <HyperlinkButton Click="OnAddConfigButtonClick" Content="添加配置" />
            </base:EmptyHolder.ActionElement>
        </base:EmptyHolder>
        <Grid Visibility="{x:Bind ViewModel.IsNoConfig, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="16,8,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <BreadcrumbBar
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ItemClicked="OnPathSegmentClick"
                    ItemsSource="{x:Bind ViewModel.PathSegments}"
                    UseLayoutRounding="False">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="viewModel:WebDavPathSegment">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
                <HyperlinkButton
                    Grid.Column="1"
                    Click="OnEditConfigButtonClick"
                    Content="修改配置"
                    FontSize="12" />
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}">
                <ItemsControl Margin="16,12" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModel:WebDavStorageItemViewModel">
                            <controls:WebDavStorageItemControl Margin="0,4" ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <base:LoadingWidget
                Grid.Row="1"
                Margin="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Text="加载中..."
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</local:WebDavVideoPageBase>
