<?xml version="1.0" encoding="utf-8" ?>
<local:WebDavStorageItemControlBase
    x:Class="WinUISample.Controls.WebDavStorageItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUISample.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <base:CardControl Command="{x:Bind ViewModel.ActivateCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <FontIcon
                Margin="0,0,4,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Emoji"
                FontSize="32"
                Glyph="{x:Bind ViewModel.Icon, Mode=OneWay}" />
            <base:TrimTextBlock
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                MaxLines="1"
                Text="{x:Bind ViewModel.Data.DisplayName, Mode=OneWay}" />
        </Grid>
    </base:CardControl>
</local:WebDavStorageItemControlBase>
