<?xml version="1.0" encoding="utf-8" ?>
<local:RootLayoutBase
    x:Class="WinUISample.Controls.RootLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:WinUISample.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Rectangle Grid.RowSpan="2" Fill="{ThemeResource LayerFillColorDefaultBrush}" />
        <base:AppTitleBar x:Name="TitleBar" Title="MPV 测试">
            <base:AppTitleBar.CenterContent>
                <controls:Segmented
                    x:Name="Section"
                    IsEnabled="{x:Bind ViewModel.LibMpvPath, Mode=OneWay, Converter={StaticResource ObjectToBoolConverter}}"
                    SelectionChanged="OnSectionTypeChanged">
                    <controls:SegmentedItem Content="本地视频" />
                    <controls:SegmentedItem Content="哔哩哔哩" />
                    <controls:SegmentedItem Content="WebDAV" />
                </controls:Segmented>
            </base:AppTitleBar.CenterContent>
            <base:AppTitleBar.Footer>
                <Button
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.OpenLoggerFolderCommand}"
                    Style="{StaticResource SmallIconButtonStyle}"
                    ToolTipService.ToolTip="打开日志目录">
                    <ic:SymbolIcon FontSize="14" Symbol="DocumentFolder" />
                </Button>
            </base:AppTitleBar.Footer>
        </base:AppTitleBar>
        <Grid
            Grid.Row="1"
            Padding="12,0,12,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                MinWidth="120"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.PickLibMpvCommand}"
                Content="选择 libmpv" />
            <base:TrimTextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Text="{x:Bind ViewModel.LibMpvPath, Mode=OneWay}" />
            <ComboBox
                x:Name="DecodeComboBox"
                Grid.Column="2"
                SelectionChanged="OnDecodeChanged">
                <ComboBoxItem Content="自动" />
                <ComboBoxItem Content="D3D11" />
                <ComboBoxItem Content="NVDEC" />
                <ComboBoxItem Content="Vulkan" />
            </ComboBox>
        </Grid>
        <Rectangle x:Name="PlacementRect" Grid.Row="1" />
        <Grid Grid.Row="2">
            <Frame
                x:Name="MainFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.LibMpvPath, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
            <base:EmptyHolder
                Title="需要 libmpv"
                Description="请选择一个 libmpv.dll 文件用以播放视频"
                Emoji="&#x1F4C2;"
                Visibility="{x:Bind ViewModel.LibMpvPath, Mode=OneWay, Converter={StaticResource ObjectToVisibilityReverseConverter}}" />
        </Grid>
    </Grid>
</local:RootLayoutBase>
